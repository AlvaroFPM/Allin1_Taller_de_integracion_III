# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile Multi-Stage — Microservicio Chat
# ==============================================================================
# Imagen optimizada para producción del microservicio de Chat.
#   - HTTP/WebSocket en puerto 8085
#   - gRPC nativo en puerto 50054
#
# Build context: backend-go/
# Comando de build de ejemplo:
#   docker build -f Dockerfile.chat -t am4roo/allin1-chat-go:<YYYYMMDD-hash> .
#
# Nota: Las variables de entorno sensibles (DB_*, JWT_SECRET, GRPC_PORT,
# HTTP_PORT) se inyectan en runtime a través de Kubernetes.
# ==============================================================================

# ==============================================================================
# ETAPA 1: Builder (Compilación y generación de binario estático)
# ==============================================================================
# Usamos una imagen de Go basada en Alpine Linux para compilar.
# Alpine es liviana (~300 MB) pero contiene las herramientas necesarias del SDK de Go.
FROM golang:1.27-alpine AS builder

# Instalamos ca-certificates y tzdata en el builder:
# 1. ca-certificates: Certificados SSL/TLS raíz para conexiones seguras (PostgreSQL, HTTPS).
# 2. tzdata: Información de zonas horarias para manejo correcto de fechas/horas en Go.
RUN apk add --no-cache ca-certificates tzdata

# Establecemos el directorio de trabajo dentro del contenedor builder.
WORKDIR /src

# OPTIMIZACIÓN DE CAPAS (Layer Caching):
# Copiamos primero únicamente los archivos de definición de dependencias.
# Docker guardará esta capa en caché; solo se re-ejecutará 'go mod download'
# si go.mod o go.sum cambian, acelerando drásticamente builds posteriores.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Copiamos todo el código fuente del módulo Go (cmd/, internal/, api/, etc.).
COPY . .

# COMPILACIÓN DEL BINARIO ESTÁTICO:
# - CGO_ENABLED=0: Binario 100% estático sin dependencias de librerías C (cgo).
#   Esto permite ejecutar directamente sobre 'scratch' sin libc/musl.
# - GOOS=linux: Garantiza ejecutable Linux incluso compilando desde Windows/macOS.
# - -trimpath: Elimina rutas absolutas del host del binario (reproducibilidad).
# - -ldflags="-s -w": Elimina tabla de símbolos (-s) e info DWARF (-w),
#   reduciendo el tamaño del binario ~20-30% sin afectar rendimiento.
# - Caché de módulos y build aceleran compilaciones sucesivas.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/chat ./cmd/chat

# ==============================================================================
# ETAPA 2: Final / Runtime (Imagen ultra liviana y segura)
# ==============================================================================
# Usamos 'scratch' como imagen base. 'scratch' es una imagen vacía de 0 bytes
# (no contiene sistema operativo, ni shell, ni paquetes superfluos).
#
# Ventajas:
# 1. Tamaño mínimo: Solo pesa lo que pesa el binario + certificados CA + tzdata.
# 2. Máxima seguridad: Sin shell ni gestor de paquetes, la superficie de ataque
#    y las vulnerabilidades (CVEs) se reducen a prácticamente cero.
FROM scratch

# Labels OCI mínimos para identificación de la imagen.
LABEL org.opencontainers.image.title="chat" \
      org.opencontainers.image.source="https://github.com/AlvaroFPM/Allin1_Taller_de_integracion_III"

# Copiamos los certificados SSL/TLS raíz desde la etapa 'builder'.
# Fundamental para que GORM/pgx validen TLS al conectar con PostgreSQL.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Copiamos la información de zonas horarias para manipulación de timestamps (time.Location).
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Copiamos ÚNICAMENTE el binario estático compilado desde la etapa 'builder'.
COPY --from=builder /out/chat /app/chat

# Ejecutamos como usuario no-root (UID/GID numérico; scratch no tiene /etc/passwd).
# 65532 es el UID estándar de 'nonroot' en distroless.
USER 65532:65532

# EXPOSE: Puertos de comunicación del microservicio Chat.
# - 8085:  Puerto HTTP/WebSocket.
# - 50054: Puerto gRPC nativo.
EXPOSE 8085 50054

# ENTRYPOINT: Ejecuta directamente el binario compilado como proceso principal (PID 1).
# Forma exec (sin shell) para correcto manejo de señales SIGTERM/SIGINT.
ENTRYPOINT ["/app/chat"]
