{
  "swagger": "2.0",
  "info": {
    "title": "Allin1 - IAM (Auth y Perfil)",
    "description": "Registro, login y perfil de usuario. Los endpoints de perfil requieren el token JWT obtenido en login o registro, enviado en el header Authorization con el formato: Bearer TOKEN.",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "AuthService",
      "description": "AuthService provee métodos para registro, login y perfil."
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "summary": "Iniciar sesion",
        "description": "Valida correo y contrasena y devuelve un token JWT. No requiere autenticacion. Un correo inexistente y una contrasena incorrecta devuelven el mismo 401.",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/authLoginResponse"
            }
          },
          "400": {
            "description": "Datos de login invalidos (campos vacios o con formato incorrecto).",
            "schema": {}
          },
          "401": {
            "description": "Credenciales incorrectas.",
            "schema": {}
          },
          "500": {
            "description": "Error interno (base de datos o generacion del token).",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authLoginRequest"
            }
          }
        ],
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/profile": {
      "get": {
        "summary": "Obtener perfil",
        "description": "Devuelve el perfil del usuario dueno del token. Si el usuario aun no tiene perfil, los campos de perfil vienen vacios (no es un error). Si no tiene foto propia, fotoPerfilUrl trae el avatar por defecto alojado en Cloudinary.",
        "operationId": "AuthService_GetProfile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/authProfileResponse"
            }
          },
          "401": {
            "description": "Token ausente, con formato invalido, invalido o expirado.",
            "schema": {}
          },
          "404": {
            "description": "El usuario del token no existe.",
            "schema": {}
          },
          "500": {
            "description": "Error interno al consultar la base de datos.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "Perfil"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "Actualizar perfil",
        "description": "Reemplaza los datos editables del perfil (reemplazo total: los campos vacios borran el valor guardado). Crea el perfil si no existia. Devuelve el perfil actualizado.",
        "operationId": "AuthService_UpdateProfile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/authProfileResponse"
            }
          },
          "400": {
            "description": "Telefono invalido (7 a 20 caracteres: digitos, espacios, +, - o parentesis) o ciudad/region de mas de 100 caracteres.",
            "schema": {}
          },
          "401": {
            "description": "Token ausente, con formato invalido, invalido o expirado.",
            "schema": {}
          },
          "404": {
            "description": "El usuario del token no existe.",
            "schema": {}
          },
          "500": {
            "description": "Error interno al guardar o consultar en la base de datos.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authUpdateProfileRequest"
            }
          }
        ],
        "tags": [
          "Perfil"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Registrar usuario",
        "description": "Crea una cuenta nueva y devuelve un token JWT para iniciar sesion de inmediato. No requiere autenticacion.",
        "operationId": "AuthService_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/authRegisterResponse"
            }
          },
          "400": {
            "description": "Datos de registro invalidos (RUT, nombre, correo o contrasena).",
            "schema": {}
          },
          "409": {
            "description": "El correo ya esta registrado.",
            "schema": {}
          },
          "500": {
            "description": "Error interno (base de datos, hash de contrasena o generacion del token).",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authRegisterRequest"
            }
          }
        ],
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "definitions": {
    "authLoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "title": "Mensajes para el Login"
    },
    "authLoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "authProfileResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "int64"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "bioExperiencia": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "habilidades": {
          "type": "string"
        },
        "ciudad": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "fotoPerfilUrl": {
          "type": "string",
          "description": "URL de la foto de perfil. Si el usuario no tiene foto propia, es el avatar por defecto (Cloudinary)."
        },
        "rol": {
          "type": "string",
          "description": "Rol del usuario (por ejemplo CLIENTE o PROVEEDOR)."
        }
      }
    },
    "authRegisterRequest": {
      "type": "object",
      "properties": {
        "rut": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "title": "Mensajes para el Registro"
    },
    "authRegisterResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      }
    },
    "authUpdateProfileRequest": {
      "type": "object",
      "properties": {
        "bioExperiencia": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        },
        "habilidades": {
          "type": "string"
        },
        "ciudad": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "title": "Mensajes para actualizar el perfil (los campos vacíos reemplazan el valor guardado)"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "Token JWT. Escribir el valor completo: Bearer TOKEN (con la palabra Bearer y un espacio).",
      "name": "Authorization",
      "in": "header"
    }
  }
}
