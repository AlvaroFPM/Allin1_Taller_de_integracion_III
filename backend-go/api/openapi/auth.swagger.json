        },
        "ciudad": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "fotoPerfilUrl": {
          "type": "string"
        }
      }
    },
    "authRegisterRequest": {
      "type": "object",
      "properties": {
        "rut": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
