# ==============================================================================
# Variables de entorno para desarrollo local del frontend Next.js
# ==============================================================================
# Copia este archivo como .env.local y ajusta los valores según tu entorno.
#
# IMPORTANTE: Las variables NEXT_PUBLIC_* se incrustan en el bundle JS
# durante `npm run build` (build time). En producción se pasan como
# --build-arg en docker build, NO como env del Deployment de K8s.
# ==============================================================================

# URL del API Gateway (IAM: /v1/auth/*)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL del microservicio de Catálogo (Publicaciones: /v1/publications/*, Categorías: /v1/categories/*)
NEXT_PUBLIC_CATALOG_API_URL=http://localhost:8082

# URL interna para Server Components hacia el microservicio de Catálogo (solo servidor, opcional en local).
# En Kubernetes apunta a http://catalog:8082 dentro de la red del cluster.
# CATALOG_INTERNAL_URL=http://localhost:8082

