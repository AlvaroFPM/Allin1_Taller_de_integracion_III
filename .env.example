# ==========================================
# Contraseñas para bases de datos PostgreSQL
# ==========================================
# NOTA: En el entorno local/desarrollo copia este archivo como .env
# y configura las contraseñas reales. NO subas tu .env real a Git.

POSTGRES_PASSWORD_IAM=local_iam_pass
POSTGRES_PASSWORD_CATALOG=local_catalog_pass
POSTGRES_PASSWORD_PAYMENTS=local_payments_pass
POSTGRES_PASSWORD_REPUTATION=local_reputation_pass
POSTGRES_PASSWORD_CHAT=local_chat_pass
POSTGRES_PASSWORD_SUPPORT=local_support_pass
POSTGRES_PASSWORD_NOTIFY=local_notify_pass
POSTGRES_PASSWORD_GEO=local_geo_pass
POSTGRES_PASSWORD_SEARCH=local_search_pass
POSTGRES_PASSWORD_MATCH=local_match_pass
