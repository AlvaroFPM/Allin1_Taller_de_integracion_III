# ==============================================================================
# NOTA: Este archivo reemplaza al .env.example anterior (arquitectura NestJS
# ya descontinuada). Unifica la configuración para la arquitectura actual.
# ==============================================================================

# ==========================================
# Variables de entorno - Backend Go
# ==========================================
# NOTA: estas variables son genéricas y se inyectan de forma distinta
# por cada microservicio (iam, catalog, media) al momento de desplegar
# -- ya sea vía Docker Compose o Kubernetes. El valor de ejemplo de
# abajo corresponde a un solo microservicio de referencia.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_password
DB_NAME=iam_db
DB_SSLMODE=disable

# JWT_SECRET — Clave para firmar/verificar tokens JWT (HS256).
# Generar con: openssl rand -hex 32
# Si está vacío el código Go usa un fallback inseguro de desarrollo.
JWT_SECRET=REEMPLAZAR_POR_VALOR_ALEATORIO_DE_64_HEX

# Passwords para los contenedores PostgreSQL (docker-compose.yml)
POSTGRES_PASSWORD_IAM=cambia_esta_password
POSTGRES_PASSWORD_CATALOG=cambia_esta_password

# ==========================================
# Variables de entorno - Frontend (Next.js)
# ==========================================
# Pendiente de integración real con el backend. Placeholder para cuando
# el frontend empiece a consumir la API.
NEXT_PUBLIC_API_URL=http://localhost:8080