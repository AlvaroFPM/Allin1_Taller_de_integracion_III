{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/backend-microservices/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/backend-microservices/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/backend-microservices",
  "projects": {
    "backend-microservices": {
      "type": "application",
      "root": "apps/backend-microservices",
      "entryFile": "main",
      "sourceRoot": "apps/backend-microservices/src",
      "compilerOptions": {
        "tsConfigPath": "apps/backend-microservices/tsconfig.app.json"
      }
    },
    "catalog": {
      "type": "application",
      "root": "apps/catalog",
      "entryFile": "main",
      "sourceRoot": "apps/catalog/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catalog/tsconfig.app.json"
      }
    },
    "chat": {
      "type": "application",
      "root": "apps/chat",
      "entryFile": "main",
      "sourceRoot": "apps/chat/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chat/tsconfig.app.json"
      }
    },
    "front": {
      "type": "application",
      "root": "apps/front",
      "entryFile": "main",
      "sourceRoot": "apps/front/src",
      "compilerOptions": {
        "tsConfigPath": "apps/front/tsconfig.app.json"
      }
    },
    "geo": {
      "type": "application",
      "root": "apps/geo",
      "entryFile": "main",
      "sourceRoot": "apps/geo/src",
      "compilerOptions": {
        "tsConfigPath": "apps/geo/tsconfig.app.json"
      }
    },
    "iam": {
      "type": "application",
      "root": "apps/iam",
      "entryFile": "main",
      "sourceRoot": "apps/iam/src",
      "compilerOptions": {
        "tsConfigPath": "apps/iam/tsconfig.app.json"
      }
    },
    "match": {
      "type": "application",
      "root": "apps/match",
      "entryFile": "main",
      "sourceRoot": "apps/match/src",
      "compilerOptions": {
        "tsConfigPath": "apps/match/tsconfig.app.json"
      }
    },
    "notify": {
      "type": "application",
      "root": "apps/notify",
      "entryFile": "main",
      "sourceRoot": "apps/notify/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notify/tsconfig.app.json"
      }
    },
    "payments": {
      "type": "application",
      "root": "apps/payments",
      "entryFile": "main",
      "sourceRoot": "apps/payments/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payments/tsconfig.app.json"
      }
    },
    "reputation": {
      "type": "application",
      "root": "apps/reputation",
      "entryFile": "main",
      "sourceRoot": "apps/reputation/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reputation/tsconfig.app.json"
      }
    },
    "search": {
      "type": "application",
      "root": "apps/search",
      "entryFile": "main",
      "sourceRoot": "apps/search/src",
      "compilerOptions": {
        "tsConfigPath": "apps/search/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "support": {
      "type": "application",
      "root": "apps/support",
      "entryFile": "main",
      "sourceRoot": "apps/support/src",
      "compilerOptions": {
        "tsConfigPath": "apps/support/tsconfig.app.json"
      }
    }
  }
}