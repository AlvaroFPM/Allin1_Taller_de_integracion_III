PAYMENTS_DATABASE_URL="postgresql://postgres:postgres@localhost:5435/payments_db?schema=public"

# apps/reputation
REPUTATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5436/reputation_db?schema=public"

# apps/chat
CHAT_DATABASE_URL="postgresql://postgres:postgres@localhost:5437/chat_db?schema=public"

# apps/support
