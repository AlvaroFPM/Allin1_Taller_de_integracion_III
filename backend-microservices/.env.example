# ==========================================
# Credenciales de Base de Datos - Desarrollo Local
# Postgres independiente por microservicio (1 contenedor Docker c/u)
# ==========================================

# apps/iam
IAM_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/iam_db?schema=public"

# apps/catalog
CATALOG_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/catalog_db?schema=public"

# apps/payments
PAYMENTS_DATABASE_URL="postgresql://postgres:postgres@localhost:5435/payments_db?schema=public"

# apps/reputation
REPUTATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5436/reputation_db?schema=public"

# apps/chat
CHAT_DATABASE_URL="postgresql://postgres:postgres@localhost:5437/chat_db?schema=public"

# apps/support
SUPPORT_DATABASE_URL="postgresql://postgres:postgres@localhost:5438/support_db?schema=public"

# apps/notify
NOTIFY_DATABASE_URL="postgresql://postgres:postgres@localhost:5439/notify_db?schema=public"

# apps/geo
GEO_DATABASE_URL="postgresql://postgres:postgres@localhost:5440/geo_db?schema=public"

# apps/search
SEARCH_DATABASE_URL="postgresql://postgres:postgres@localhost:5441/search_db?schema=public"

# apps/match
MATCH_DATABASE_URL="postgresql://postgres:postgres@localhost:5442/match_db?schema=public"

# ==========================================
# Cloudinary (subida de imágenes)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Pagos
# ==========================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ==========================================
# Geolocalización
# ==========================================
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ==========================================
# Configuración General
# ==========================================
NODE_ENV=development
PORT=3000